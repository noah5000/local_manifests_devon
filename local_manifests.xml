<?xml version="1.0" encoding="UTF-8"?>
<!--
  PenguinOS (AOSPA/CLO base, branch celerity) local manifest for Moto G32 "devon" (SM6225 / bengal).
  First version: meant for a sync test. Device trees are still the Infinity branches;
  switch them to penguin-A17 branches once those exist.

  Remotes already defined by the PenguinOS manifest and used here: github, aospa
-->
<manifest>

  <!-- Extra remote for the AOSP kernel build tools (own name, so it cannot clash with PenguinOS remotes) -->
  <remote name="aosp-km" fetch="https://android.googlesource.com" />

  <!-- ===== Device (existing sources) ===== -->
  <project name="noah5000/android_device_motorola_devon_professor"
           path="device/motorola/devon"
           remote="github"
           revision="penguin" />

  <project name="noah5000/android_device_motorola_sm6225-common"
           path="device/motorola/sm6225-common"
           remote="github"
           revision="penguin" />

  <project name="TheMuppets/proprietary_vendor_motorola_sm6225-common"
           path="vendor/motorola/sm6225-common"
           remote="github"
           revision="lineage-23.2" />

  <project name="TheMuppets/proprietary_vendor_motorola_devon"
           path="vendor/motorola/devon"
           remote="github"
           revision="lineage-23.2" />

  <project name="frosti500/android_kernel_motorola_sm6225"
           path="kernel/motorola/sm6225"
           remote="github"
           revision="A17V2" />

  <project name="noah5000/android_hardware_motorola"
           path="hardware/motorola"
           remote="github"
           revision="lineageA17" />

  <!-- Dolby is left out of the first build:
  <project name="tranQuila-Project/vendor_lunaris_dolby"
           path="vendor/lunaris/dolby"
           remote="github"
           revision="main" />
  -->

  <!-- ===== In-tree kernel build (replaces vendor/lineage kernel build) ===== -->
  <project name="noah5000/vendor_kernelbuild"
           path="vendor/kernelbuild"
           remote="github"
           revision="main" />

  <project name="kernel/prebuilts/build-tools"
           path="prebuilts/kernel-build-tools"
           remote="aosp-km"
           revision="main-kernel-2025"
           clone-depth="1" />

  <project name="LineageOS/android_prebuilts_tools-lineage"
           path="prebuilts/tools-lineage"
           remote="github"
           revision="lineage-24.0"
           clone-depth="1" />

  <!-- Remove AOSPA's kernel_definitions.mk auto-include (a second kernel build) by re-adding
       the project at the same path without its linkfile -->
  <remove-project name="AOSPA/android_kernel_build" />
  <project name="AOSPA/android_kernel_build"
           path="device/qcom/kernelscripts"
           remote="aospa"
           revision="calcite" />

   <!-- ===== AOSPA bengal HALs (same set AOSPA uses for SM6225) ===== -->
  <project path="vendor/qcom/opensource/audio-hal/primary-hal"
           name="AOSPA/android_hardware_qcom_audio"
           remote="aospa" revision="vauxite-bengal" />
  <project path="hardware/qcom/display"
           name="AOSPA/android_hardware_qcom_display"
           remote="aospa" revision="vauxite-865" />
  <project path="hardware/qcom/gps"
           name="AOSPA/android_hardware_qcom_gps"
           remote="aospa" revision="vauxite-legacy-component" />
  <project path="hardware/qcom/media"
           name="AOSPA/android_hardware_qcom_media"
           remote="aospa" revision="vauxite-865" />
  <remove-project name="AOSPA/android_hardware_qcom_thermal" />
  <project path="vendor/qcom/opensource/thermal-hal"
           name="AOSPA/android_hardware_qcom_thermal"
           remote="aospa" revision="vauxite-legacy" />

   <!-- Boot control: keep the Lineage one that already boots on devon -->
  <project name="LineageOS/android_hardware_qcom_bootctrl"
           path="hardware/qcom-caf/bootctrl"
           remote="github"
           revision="lineage-24.0-caf" />
  <remove-project name="platform/hardware/qcom/bootctrl" optional="true" />


    <project name="tranQuila-Project/vendor_lunaris_dolby"
           path="vendor/lunaris/dolby"
           remote="github"
           revision="main" />

</manifest>
